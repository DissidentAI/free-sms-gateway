# Set your Free Mobile subscriber login (usually 8 digits).
FREE_USER=YOUR_EIGHT_DIGIT_LOGIN
# Rotate the API key if it has ever been exposed.
FREE_API_KEY=YOUR_NEW_FREE_SMS_API_KEY
# Generate a separate random >=32-character token for each client.
# Example command: python3 -c 'import secrets; print(secrets.token_urlsafe(36))'
CLIENT_KEYS={"monitoring":"REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS","automation":"REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_32_CHARACTERS"}
MIN_SMS_INTERVAL_SEC=60
DAILY_SMS_LIMIT=100
CLIENT_HOURLY_LIMIT=20
DEDUP_WINDOW_SEC=300
DB_PATH=/data/alerts.sqlite3

# Alert life cycle and capacity controls
DEFAULT_ALERT_TTL_SEC=3600
MAX_PENDING_ALERTS=1000
RETENTION_DAYS=30
MAX_BACKLOG_AGE_SEC=600
MAX_SEND_ATTEMPTS=6
